MYSQL_DATABASE=scms
MYSQL_USER=scms_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-root-password
DATABASE_URL=mysql+pymysql://scms_app:replace-with-a-local-password@mysql:3306/scms?charset=utf8mb4
# Generate a unique 32-byte value and encode it as unpadded base64url. Never reuse this placeholder.
SCMS_JWT_SECRET=replace-with-unpadded-base64url-encoded-random-bytes
SCMS_JWT_ISSUER=scms-local
SCMS_JWT_AUDIENCE=scms-api
SCMS_AUTH_ALLOWED_ORIGINS=http://localhost:8080
# Local HTTP demo only. Production startup rejects false and defaults to Secure cookies.
SCMS_COOKIE_SECURE=false
